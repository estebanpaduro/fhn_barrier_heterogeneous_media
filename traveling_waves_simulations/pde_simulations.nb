Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Standing", " ", "Waves", " ", "2"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"xmin", "=", 
     RowBox[{"-", "100"}]}], ";", 
    RowBox[{"xmax", "=", "100"}], ";", 
    RowBox[{"maxtime", "=", "500"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"V1", ",", "W1"}], "}"}], "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"u", "[", 
             RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "t"}], "]"}], " ",
           "==", " ", 
          RowBox[{
           RowBox[{"0.5", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"u", "[", 
               RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "x", ",", " ", 
              "x"}], "]"}]}], " ", "+", " ", 
           RowBox[{
            RowBox[{"u", "[", 
             RowBox[{"t", ",", " ", "x"}], "]"}], 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{
               RowBox[{
                RowBox[{"\[Rho]", "[", "x", "]"}], "^", "2"}], "/", "2"}]}], 
             ")"}]}], " ", "-", 
           RowBox[{
            RowBox[{
             RowBox[{"u", "[", 
              RowBox[{"t", ",", "x"}], "]"}], "^", "3"}], "/", "3"}], " ", "-",
            " ", 
           RowBox[{"w", "[", 
            RowBox[{"t", ",", "x"}], "]"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"w", "[", 
             RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "t"}], "]"}], " ",
           "==", " ", 
          RowBox[{
           RowBox[{"0.001", " ", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"w", "[", 
               RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "x", ",", " ", 
              "x"}], "]"}]}], " ", "+", " ", 
           RowBox[{"ep", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"u", "[", 
               RowBox[{"t", ",", " ", "x"}], "]"}], " ", "-", " ", 
              RowBox[{"\[Gamma]", " ", 
               RowBox[{"w", "[", 
                RowBox[{"t", ",", " ", "x"}], "]"}]}], "+", "\[Beta]"}], 
             ")"}]}]}]}], ",", " ", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"0", ",", " ", "x"}], "]"}], " ", "==", " ", "v0"}], ",", 
         " ", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"t", ",", " ", "xmin"}], "]"}], " ", "==", " ", "v0"}], ",",
          " ", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"t", ",", " ", "xmax"}], "]"}], " ", "==", " ", "v0"}], ",",
          " ", 
         RowBox[{
          RowBox[{"w", "[", 
           RowBox[{"0", ",", " ", "x"}], "]"}], " ", "==", "w0"}], ",", " ", 
         RowBox[{
          RowBox[{"w", "[", 
           RowBox[{"t", ",", " ", "xmin"}], "]"}], " ", "==", " ", "w0"}], ",", 
         RowBox[{
          RowBox[{"w", "[", 
           RowBox[{"t", ",", " ", "xmax"}], "]"}], " ", "==", " ", "w0"}]}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "w"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "maxtime"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "xmin", ",", " ", "xmax"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"V1", "[", 
        RowBox[{"maxtime", ",", "x"}], "]"}], ",", 
       RowBox[{"W1", "[", 
        RowBox[{"maxtime", ",", "x"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "20"}], ",", "20"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Animate", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"V1", "[", 
          RowBox[{"t", ",", "x"}], "]"}], ",", 
         RowBox[{"W1", "[", 
          RowBox[{"t", ",", "x"}], "]"}], ",", 
         RowBox[{
          RowBox[{"0.5", 
           RowBox[{
            RowBox[{
             RowBox[{"Derivative", "[", 
              RowBox[{"0", ",", " ", "2"}], "]"}], "[", "V1", "]"}], "[", 
            RowBox[{"t", ",", " ", "x"}], "]"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"V1", "[", 
            RowBox[{"t", ",", " ", "x"}], "]"}], 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Rho]", "[", "x", "]"}], "^", "2"}], "/", "2"}]}], 
            ")"}]}], " ", "-", 
          RowBox[{
           RowBox[{
            RowBox[{"V1", "[", 
             RowBox[{"t", ",", "x"}], "]"}], "^", "3"}], "/", "3"}], " ", "-",
           " ", 
          RowBox[{"W1", "[", 
           RowBox[{"t", ",", "x"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "20"}], ",", "20"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", 
