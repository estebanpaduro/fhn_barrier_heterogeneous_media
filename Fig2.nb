              RowBox[{
               RowBox[{"u", "[", 
                RowBox[{"t", ",", "x"}], "]"}], "-", 
               RowBox[{"\[Gamma]", " ", 
                RowBox[{"w", "[", 
                 RowBox[{"t", ",", "x"}], "]"}]}]}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"u", "[", 
