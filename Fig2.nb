 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Experiment", " ", "1", 
    RowBox[{"a", ":", " ", 
     RowBox[{"Testing", " ", "different", " ", "values", " ", "of", " ", 
      RowBox[{"p", ".", " ", "Case"}], " ", 
