   RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Switch", "[", 
         RowBox[{"case", ",", "\[IndentingNewLine]", "1", ",", 
          RowBox[{
           RowBox[{"suffix", "=", "\"\<b.pdf\>\""}], ";", 
           RowBox[{"p", "=", "0.11"}], ";"}], ",", "\[IndentingNewLine]", "2",
           ",", 
          RowBox[{
