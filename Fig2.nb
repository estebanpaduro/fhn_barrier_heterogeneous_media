              RowBox[{"{", "xmax", "}"}]}], "}"}], "]"}], ",", 
           RowBox[{"MaxCellMeasure", "->", "0.1"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"V1", ",", "W1"}], "}"}], "=", 
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"u", "[", 
                 RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}], "==", 
              RowBox[{
               RowBox[{"Laplacian", "[", 
                RowBox[{
                 RowBox[{"u", "[", 
                  RowBox[{"t", ",", "x"}], "]"}], ",", 
                 RowBox[{"{", "x", "}"}]}], "]"}], "+", 
               RowBox[{
                RowBox[{"u", "[", 
                 RowBox[{"t", ",", "x"}], "]"}], " ", 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"u", "[", 
                   RowBox[{"t", ",", "x"}], "]"}]}], ")"}], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"u", "[", 
                   RowBox[{"t", ",", "x"}], "]"}], "-", "\[Alpha]"}], ")"}]}],
                "-", 
               RowBox[{"w", "[", 
                RowBox[{"t", ",", "x"}], "]"}], "+", 
               RowBox[{"p", " ", 
                RowBox[{"g", "[", 
                 RowBox[{
                  RowBox[{"u", "[", 
                   RowBox[{"t", ",", "x"}], "]"}], ",", "x"}], "]"}]}], "+", 
               RowBox[{"NeumannValue", "[", 
                RowBox[{"0", ",", 
                 RowBox[{
                  RowBox[{"x", "==", "xmin"}], "||", 
                  RowBox[{"x", "==", "xmax"}]}]}], "]"}]}]}], ",", 
