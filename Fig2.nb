           RowBox[{"suffix", "=", "\"\<d.pdf\>\""}], ";", 
           RowBox[{"p", "=", "3.7"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"g", "[", 
          RowBox[{"v_", ",", "x_"}], "]"}], "=", 
         RowBox[{
          RowBox[{"-", "v"}], " ", "*", 
          RowBox[{"Boole", "[", 
           RowBox[{"x", ">", "0"}], "]"}], " ", "*", 
          RowBox[{"Boole", "[", 
           RowBox[{"x", "<", "L"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"mesh", "=", 
         RowBox[{"ToElementMesh", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
