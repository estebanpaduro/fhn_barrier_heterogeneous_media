Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"VV1", ",", "WW1"}], "}"}], "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "t"}], "]"}], " ", "==",
         "  ", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"u", "[", 
            RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "x", ",", " ", 
           "x"}], "]"}], "+", 
         RowBox[{"f", "[", 
          RowBox[{"u", "[", 
           RowBox[{"t", ",", " ", "x"}], "]"}], "]"}], "+", 
         RowBox[{"p1", " ", 
          RowBox[{"g", "[", 
           RowBox[{"u", "[", 
            RowBox[{"t", ",", " ", "x"}], "]"}], "]"}], 
          RowBox[{"phi", "[", 
           RowBox[{"x", "/", "0.3"}], "]"}]}], "-", " ", 
         RowBox[{"w", "[", 
          RowBox[{"t", ",", "x"}], "]"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"w", "[", 
           RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "t"}], "]"}], " ", "==",
         " ", 
        RowBox[{"ep", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"u", "[", 
            RowBox[{"t", ",", " ", "x"}], "]"}], " ", "-", " ", 
           RowBox[{"\[Gamma]", " ", 
            RowBox[{"w", "[", 
             RowBox[{"t", ",", " ", "x"}], "]"}]}]}], ")"}]}]}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"0", ",", " ", "x"}], "]"}], " ", "==", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"x", "+", "3"}], "]"}], "<", "3"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"x", "+", "3"}], "]"}], "/", "3"}]}], ")"}], "1.2"}], ",",
           "True", ",", "0"}], "]"}]}], ",", " ", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"u", "[", 
