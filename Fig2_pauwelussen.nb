      RowBox[{"x", ",", 
       RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "]"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "Together", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"eqnx0", "=", 
