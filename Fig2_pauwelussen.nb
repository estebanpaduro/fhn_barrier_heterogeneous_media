 RowBox[{
  RowBox[{"x0", "=", 
   RowBox[{"x", "/.", "eqnx0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VV", "[", "x_", "]"}], "=", 
   RowBox[{"Which", "[", 
