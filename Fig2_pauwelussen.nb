         RowBox[{
          RowBox[{"v", "[", "x", "]"}], "/", "\[Gamma]"}]}]}], ",", 
       RowBox[{
        RowBox[{"v", "[", "0", "]"}], "==", "a"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"v", "'"}], "[", "0", "]"}], "==", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"r2", "^", "2"}], "/", 
            RowBox[{"r1", "^", "2"}]}], ")"}]}], 
         RowBox[{"Sqrt", "[", "2", "]"}], 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Integrate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"h", "[", "u", "]"}], "-", 
             RowBox[{"u", "/", "\[Gamma]"}]}], ",", 
