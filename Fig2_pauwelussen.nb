Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"Min", "[", 
    RowBox[{"1", ",", "a0", ",", "a1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"V2", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"v", "''"}], "[", "x", "]"}], "==", 
        RowBox[{
         RowBox[{"h", "[", 
          RowBox[{"v", "[", "x", "]"}], "]"}], "-", 
         RowBox[{
          RowBox[{"v", "[", "x", "]"}], "/", "\[Gamma]"}]}]}], ",", 
       RowBox[{
        RowBox[{"v", "[", "0", "]"}], "==", "a"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"v", "'"}], "[", "0", "]"}], "==", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Integrate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"h", "[", "u", "]"}], "-", 
             RowBox[{"u", "/", "\[Gamma]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"u", ",", "0", ",", "a"}], "}"}]}], "]"}], "]"}]}]}]}], 
      "}"}], ",", "v", ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "10"}], "}"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"V1", "=", 
