Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Plot", " ", "for", " ", "testing", " ", "block"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "Mollifier", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"phi0", "[", "x_", "]"}], "=", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "x", "]"}], "<", "1"}], ",", 
       RowBox[{"Exp", "[", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", "x", "]"}], "^", "2"}], "-", "1"}], ")"}]}], 
        "]"}], ",", "True", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"cons", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"phi0", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"phi", "[", "x_", "]"}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "cons"}], ")"}], 
      RowBox[{"phi0", "[", "x", "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"phi", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "]"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"VV1", ",", "WW1"}], "}"}], "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"u", "[", 
             RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "t"}], "]"}], " ",
           "==", "  ", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"u", "[", 
              RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "x", ",", " ", 
             "x"}], "]"}], "+", 
           RowBox[{"f", "[", 
            RowBox[{"u", "[", 
             RowBox[{"t", ",", " ", "x"}], "]"}], "]"}], "+", 
           RowBox[{"p1", " ", 
            RowBox[{"g", "[", 
             RowBox[{"u", "[", 
              RowBox[{"t", ",", " ", "x"}], "]"}], "]"}], 
            RowBox[{"phi", "[", 
             RowBox[{"x", "/", "0.3"}], "]"}]}], "-", " ", 
           RowBox[{"w", "[", 
            RowBox[{"t", ",", "x"}], "]"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"w", "[", 
             RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "t"}], "]"}], " ",
           "==", " ", 
          RowBox[{"ep", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"u", "[", 
              RowBox[{"t", ",", " ", "x"}], "]"}], " ", "-", " ", 
             RowBox[{"\[Gamma]", " ", 
              RowBox[{"w", "[", 
               RowBox[{"t", ",", " ", "x"}], "]"}]}]}], ")"}]}]}], ",", " ", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"0", ",", " ", "x"}], "]"}], " ", "==", 
          RowBox[{"Which", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"x", "+", "3"}], "]"}], "<", "3"}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"x", "+", "3"}], "]"}], "/", "3"}]}], ")"}], "1.2"}],
             ",", "True", ",", "0"}], "]"}]}], ",", " ", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"t", ",", " ", "xmin"}], "]"}], " ", "==", " ", "0"}], ",",
          " ", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"t", ",", " ", "xmax"}], "]"}], " ", "==", " ", "0"}], ",",
          " ", 
         RowBox[{
          RowBox[{"w", "[", 
           RowBox[{"0", ",", " ", "x"}], "]"}], " ", "==", "0"}]}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "w"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "maxtime"}], "}"}], ",", " ", 
       RowBox[{"{", 
