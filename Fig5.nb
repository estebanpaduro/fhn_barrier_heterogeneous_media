     RowBox[{"the", " ", 
      RowBox[{"approach", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"valuek", "=", 
     RowBox[{"Min", "[", 
      RowBox[{"1", ",", "maxValuek"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
