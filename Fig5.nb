   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"timeList", "=", 
      RowBox[{"{", "}"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"i", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"simulation", ",", 
               RowBox[{"{", 
                RowBox[{"p", ",", "L", ",", "_"}], "}"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{"i", "=", 
               RowBox[{"i", "+", "1"}]}], ";", 
              RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{"v_", ",", "x_"}], "]"}], "=", 
            RowBox[{
             RowBox[{"-", "v"}], " ", "*", 
             RowBox[{"Boole", "[", 
              RowBox[{"x", ">", "0"}], "]"}], " ", "*", 
             RowBox[{"Boole", "[", 
              RowBox[{"x", "<", "L"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"mesh", "=", 
            RowBox[{"ToElementMesh", "[", 
             RowBox[{
              RowBox[{"Line", "[", 
