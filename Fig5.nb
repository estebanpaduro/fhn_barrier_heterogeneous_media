   RowBox[{"(*", 
    RowBox[{"Must", " ", "satisfy", " ", "hypothesis", " ", "on", " ", "f"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "v_", "]"}], "=", 
     RowBox[{"v", 
      RowBox[{"(", 
       RowBox[{"1", "-", "v"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"v", "-", "\[Alpha]"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"h", "[", "v_", "]"}], "=", 
     RowBox[{"Min", "[", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"-", "v"}], "]"}], ",", 
       RowBox[{"-", 
        RowBox[{"f", "[", "v", "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"h", "[", "K", "]"}], "-", 
       RowBox[{"K", "/", "\[Gamma]"}]}], "<", "0"}], ",", 
     RowBox[{"Print", "[", "\"\<You must choose a larger K\>\"", "]"}]}], 
    "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqn", "=", 
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"h", "[", "v", "]"}], "-", 
         RowBox[{"v", "/", "\[Gamma]"}]}], "==", "0"}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0.2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxValuek", "=", 
     RowBox[{"v", "/.", "eqn"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
