 CellChangeTimes->{{3.991241002394308*^9, 
  3.9912410672158775`*^9}},ExpressionUUID->"5ac76c46-a055-964c-b14a-\
6d99a054cd90"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Test", " ", "for", " ", "failure", " ", "of", " ", "propagation", " ", 
    "for", " ", "varying", " ", "p", " ", "and", " ", "D"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Case", " ", "1"}], ":", " ", 
    RowBox[{"Additive", " ", "heterogenerity"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"Not", "[", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"filename", "==", "\"\<Fig5b.png\>\""}], "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{"simulation", "=", 
       RowBox[{"{", "}"}]}], ";"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"filename", "=", "\"\<Fig5b.png\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pos", "=", "5"}], ";", 
    RowBox[{"width", "=", "4"}], ";", 
    RowBox[{"L", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"simulation", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minP", "=", "0"}], ";", 
    RowBox[{"maxP", "=", "0.3"}], ";", 
    RowBox[{"dP", "=", "0.02"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minD", "=", "1"}], ";", 
    RowBox[{"maxD", "=", "140"}], ";", 
    RowBox[{"dD", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxSteps", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Floor", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"maxP", "-", "minP"}], ")"}], "/", "dP"}], "]"}], "+", 
        "1"}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Floor", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"maxD", "-", "minD"}], ")"}], "/", "dD"}], "]"}], "+", 
        "1"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"DateString", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Hour\>\"", ",", "\"\<:\>\"", ",", "\"\<Minute\>\"", 
       ",", "\"\<:\>\"", ",", "\"\<Second\>\""}], "}"}], "]"}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"timeList", "=", 
      RowBox[{"{", "}"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"i", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"simulation", ",", 
               RowBox[{"{", 
                RowBox[{"p", ",", "D2", ",", "_"}], "}"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{"i", "=", 
               RowBox[{"i", "+", "1"}]}], ";", 
              RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{"v_", ",", "x_"}], "]"}], "=", 
            RowBox[{
             RowBox[{"-", "v"}], " ", "*", 
             RowBox[{"Boole", "[", 
              RowBox[{"x", ">", "0"}], "]"}], " ", "*", 
             RowBox[{"Boole", "[", 
              RowBox[{"x", "<", "L"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"mesh", "=", 
            RowBox[{"ToElementMesh", "[", 
             RowBox[{
              RowBox[{"Line", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", "xmin", "}"}], ",", 
                 RowBox[{"{", "xmax", "}"}]}], "}"}], "]"}], ",", 
              RowBox[{"MaxCellMeasure", "->", "0.1"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"V1", ",", "W1"}], "}"}], "=", 
            RowBox[{"NDSolveValue", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"D", "[", 
                  RowBox[{
                   RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}], "==", 
                 RowBox[{
                  RowBox[{"Laplacian", "[", 
                   RowBox[{
                    RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x"}], "]"}], ",", 
                    RowBox[{"{", "x", "}"}]}], "]"}], "+", 
                  RowBox[{
                   RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x"}], "]"}], " ", 
                   RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x"}], "]"}]}], ")"}], " ", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x"}], "]"}], "-", "\[Alpha]"}], 
                    ")"}]}], "-", 
                  RowBox[{"w", "[", 
                   RowBox[{"t", ",", "x"}], "]"}], "+", 
                  RowBox[{"p", " ", 
                   RowBox[{"g", "[", 
                    RowBox[{
                    RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x"}], "]"}], ",", "x"}], "]"}]}], "+", 
                  RowBox[{"NeumannValue", "[", 
                   RowBox[{"0", ",", 
                    RowBox[{
                    RowBox[{"x", "==", "xmin"}], "||", 
                    RowBox[{"x", "==", "xmax"}]}]}], "]"}]}]}], ",", 
                RowBox[{
                 RowBox[{"\[Tau]", " ", 
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"w", "[", 
                    RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}]}], "==", 
                 RowBox[{
                  RowBox[{"D2", " ", 
                   RowBox[{"Laplacian", "[", 
                    RowBox[{
                    RowBox[{"w", "[", 
                    RowBox[{"t", ",", "x"}], "]"}], ",", 
                    RowBox[{"{", "x", "}"}]}], "]"}]}], "+", 
                  RowBox[{"u", "[", 
                   RowBox[{"t", ",", "x"}], "]"}], "-", 
                  RowBox[{"\[Gamma]", " ", 
                   RowBox[{"w", "[", 
                    RowBox[{"t", ",", "x"}], "]"}]}], "+", 
                  RowBox[{"NeumannValue", "[", 
                   RowBox[{"0", ",", 
                    RowBox[{
                    RowBox[{"x", "==", "xmin"}], "||", 
                    RowBox[{"x", "==", "xmax"}]}]}], "]"}]}]}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"\[Tau]", " ", 
                    RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"w", "[", 
                    RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}]}], "==", 
                   RowBox[{
                    RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x"}], "]"}], "-", 
