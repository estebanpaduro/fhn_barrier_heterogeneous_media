    RowBox[{"L", "=", "0"}], ";", " ", 
    RowBox[{"sg1", "=", "1"}], ";", 
    RowBox[{"sg2", "=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"p", "+", "1"}], ")"}]}]}], ";", 
    RowBox[{"sg3", "=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"p", "+", "1"}], ")"}]}]}], ";", " ", 
    RowBox[{"K", "=", "1.3"}], ";", 
    RowBox[{"vinf", "=", "0.005"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
