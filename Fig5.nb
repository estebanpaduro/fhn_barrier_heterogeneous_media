              RowBox[{"Element", "[", 
               RowBox[{"x", ",", "mesh"}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"Method", "->", 
               RowBox[{"{", 
                RowBox[{"\"\<MethodOfLines\>\"", ",", 
