                 RowBox[{"{", "xmax", "}"}]}], "}"}], "]"}], ",", 
              RowBox[{"MaxCellMeasure", "->", "0.1"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"V1", ",", "W1"}], "}"}], "=", 
            RowBox[{"NDSolveValue", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"D", "[", 
                  RowBox[{
                   RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}], "==", 
                 RowBox[{
                  RowBox[{"Laplacian", "[", 
                   RowBox[{
                    RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x"}], "]"}], ",", 
                    RowBox[{"{", "x", "}"}]}], "]"}], "+", 
                  RowBox[{
                   RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x"}], "]"}], " ", 
                   RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x"}], "]"}]}], ")"}], " ", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x"}], "]"}], "-", "\[Alpha]"}], 
                    ")"}]}], "-", 
                  RowBox[{"w", "[", 
                   RowBox[{"t", ",", "x"}], "]"}], "+", 
                  RowBox[{"p", " ", 
                   RowBox[{"g", "[", 
                    RowBox[{
                    RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x"}], "]"}], ",", "x"}], "]"}]}], "+", 
                  RowBox[{"NeumannValue", "[", 
                   RowBox[{"0", ",", 
                    RowBox[{
                    RowBox[{"x", "==", "xmin"}], "||", 
                    RowBox[{"x", "==", "xmax"}]}]}], "]"}]}]}], ",", 
                RowBox[{
                 RowBox[{"\[Tau]", " ", 
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"w", "[", 
                    RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}]}], "==", 
                 RowBox[{
                  RowBox[{"u", "[", 
                   RowBox[{"t", ",", "x"}], "]"}], "-", 
                  RowBox[{"\[Gamma]", " ", 
                   RowBox[{"w", "[", 
                    RowBox[{"t", ",", "x"}], "]"}]}]}]}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"u", "[", 
                  RowBox[{"0", ",", "x"}], "]"}], "==", 
                 RowBox[{"0.5", " ", 
                  RowBox[{"(", 
                   RowBox[{"1", "+", 
                    RowBox[{"Cos", "[", 
                    RowBox[{"Pi", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"x", "-", "pos"}], ")"}], "/", "width"}]}], 
                    "]"}]}], ")"}], "*", 
                  RowBox[{"Boole", "[", 
                   RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"x", "-", "pos"}], "]"}], "<=", "width"}], 
                   "]"}]}]}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"w", "[", 
                  RowBox[{"0", ",", "x"}], "]"}], "==", "0"}]}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
