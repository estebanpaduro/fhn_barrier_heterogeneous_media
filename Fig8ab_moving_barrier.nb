           RowBox[{"lineColor", "=", "DarkGray"}], ";"}], ",", 
          "\[IndentingNewLine]", "2", ",", 
          RowBox[{
           RowBox[{"subfigure", "=", "\"\<Initial Data 2\>\""}], ";", 
           RowBox[{"pos", "=", "6.7"}], ";", 
           RowBox[{"width", "=", "3.2"}], ";", 
           RowBox[{"scale", "=", "3"}], ";", 
           RowBox[{"lineColor", "=", "Pink"}], ";"}]}], "\[IndentingNewLine]",
          "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"mesh", "=", 
         RowBox[{"ToElementMesh", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", "xmin", "}"}], ",", 
              RowBox[{"{", "xmax", "}"}]}], "}"}], "]"}], ",", 
           RowBox[{"MaxCellMeasure", "->", "0.1"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"VVV1", ",", "WWW1"}], "}"}], "=", 
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"u", "[", 
                 RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}], "==", 
              RowBox[{
               RowBox[{"Laplacian", "[", 
                RowBox[{
                 RowBox[{"u", "[", 
                  RowBox[{"t", ",", "x"}], "]"}], ",", 
                 RowBox[{"{", "x", "}"}]}], "]"}], "+", 
               RowBox[{
                RowBox[{"u", "[", 
                 RowBox[{"t", ",", "x"}], "]"}], " ", 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"u", "[", 
                   RowBox[{"t", ",", "x"}], "]"}]}], ")"}], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"u", "[", 
                   RowBox[{"t", ",", "x"}], "]"}], "-", "\[Alpha]"}], ")"}]}],
                "-", 
               RowBox[{"w", "[", 
                RowBox[{"t", ",", "x"}], "]"}], "+", 
               RowBox[{"NeumannValue", "[", 
                RowBox[{"0", ",", 
                 RowBox[{
                  RowBox[{"x", "==", "xmin"}], "||", 
                  RowBox[{"x", "==", "xmax"}]}]}], "]"}]}]}], ",", 
             RowBox[{
              RowBox[{"\[Tau]", " ", 
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"w", "[", 
                  RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}]}], "==", 
              RowBox[{
               RowBox[{"u", "[", 
                RowBox[{"t", ",", "x"}], "]"}], "-", 
               RowBox[{"\[Gamma]", " ", 
                RowBox[{"w", "[", 
                 RowBox[{"t", ",", "x"}], "]"}]}]}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"u", "[", 
               RowBox[{"0", ",", "x"}], "]"}], "==", 
              RowBox[{"0.5", "scale", " ", 
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{"Cos", "[", 
                  RowBox[{"Pi", " ", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"x", "-", "pos"}], ")"}], "/", "width"}]}], 
                  "]"}]}], ")"}], "*", 
               RowBox[{"Boole", "[", 
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"x", "-", "pos"}], "]"}], "<=", "width"}], 
                "]"}]}]}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"w", "[", 
               RowBox[{"0", ",", "x"}], "]"}], "==", "0"}]}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"u", ",", "w"}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "maxtime"}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Element", "[", 
            RowBox[{"x", ",", "mesh"}], "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"Method", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<MethodOfLines\>\"", ",", 
              RowBox[{"\"\<SpatialDiscretization\>\"", "->", 
               RowBox[{"{", "\"\<FiniteElement\>\"", "}"}]}]}], "}"}]}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"g2", "=", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"x", ",", 
                 RowBox[{"VVV1", "[", 
                  RowBox[{"t", ",", "x"}], "]"}]}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"x", ",", " ", 
                 RowBox[{"-", "5"}], ",", "15", ",", "0.2"}], "}"}]}], "]"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", 
               RowBox[{"{", 
                RowBox[{
                "0", ",", "0.15", ",", "0.8", ",", "2", ",", "4", ",", "8"}], 
                "}"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Directive", "[", 
               RowBox[{"lineColor", ",", 
                RowBox[{"Opacity", "[", "o", "]"}], ",", "Thick"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"o", ",", 
                RowBox[{"{", 
                 RowBox[{
                 "0.3", ",", "0.4", ",", "0.5", ",", "0.7", ",", "0.8", ",", 
                  "1.0"}], "}"}]}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]",
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"plotList", ",", "g2"}], "]"}], ";"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"filenamePrefix", "<>", "suffix"}], ",", "g2"}], "]"}], 
        "*)"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"case", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}]}], "}"}]}], "]"}], 
     "\[IndentingNewLine]", ",", 
     RowBox[{"\"\<Current: \>\"", "<>", "subfigure"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", "\"\<Done!\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{"img2", "=", 
    RowBox[{"Show", "[", "plotList", "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{"filename2", ",", "img2"}], "]"}]}]}]], "Input",
