Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Experiment", " ", "2"}], ":", " ", 
    RowBox[{"Testing", " ", "different", " ", "values", " ", "of", " ", 
     RowBox[{"p", ".", " ", "Case"}], " ", 
     RowBox[{"(", "i", ")"}]}], ":", " ", 
    RowBox[{
    "Depressed", " ", "Dynamics", " ", "with", " ", "Recovery", " ", 
     "diffusion"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"filenamePrefix", "=", "\"\<Fig3\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pos", "=", "5"}], ";", 
    RowBox[{"width", "=", "4"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Switch", "[", 
         RowBox[{"case", ",", "\[IndentingNewLine]", "1", ",", 
          RowBox[{
           RowBox[{"suffix", "=", "\"\<b.pdf\>\""}], ";", 
           RowBox[{"p", "=", "0.11"}], ";", 
           RowBox[{"dd2", "=", "1"}], ";"}], ",", "\[IndentingNewLine]", "2", 
          ",", 
          RowBox[{
           RowBox[{"suffix", "=", "\"\<c.pdf\>\""}], ";", 
