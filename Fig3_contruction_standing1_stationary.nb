Cell[BoxData[{
 RowBox[{
  RowBox[{"eqn1", "=", 
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"f1", "[", 
        RowBox[{"v", "+", "v0"}], "]"}]}], "+", 
      RowBox[{"v0", "/", "\[Gamma]"}], "-", 
      RowBox[{"v", "/", "\[Gamma]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"v", ",", "0.2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqn2", "=", 
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"f1", "[", 
        RowBox[{"v", "+", "v0"}], "]"}]}], "+", 
      RowBox[{"v0", "/", "\[Gamma]"}], "-", 
      RowBox[{"v", "/", "\[Gamma]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"v", ",", "0.4"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"v", "/.", "eqn1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", 
   RowBox[{"v", "/.", "eqn2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"V", "=", 
  RowBox[{"NDSolveValue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"v", "''"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"f1", "[", 
          RowBox[{
           RowBox[{"v", "[", "t", "]"}], "+", "v0"}], "]"}]}], "+", 
        RowBox[{"v0", "/", "\[Gamma]"}], "-", 
        RowBox[{
         RowBox[{"v", "[", "t", "]"}], "/", "\[Gamma]"}]}]}], ",", 
      RowBox[{
       RowBox[{"v", "[", "0", "]"}], "==", "a"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"v", "'"}], "[", "0", "]"}], "==", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Sqrt", "[", "2", "]"}]}], 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Integrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"f1", "[", 
              RowBox[{"u", "+", "v0"}], "]"}]}], "+", 
            RowBox[{"v0", "/", "\[Gamma]"}], "-", 
            RowBox[{"u", "/", "\[Gamma]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "0", ",", "a"}], "}"}]}], "]"}], "]"}]}]}]}], 
     "}"}], ",", "v", ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", 
      RowBox[{"-", "16"}], ",", "20"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"v0", "+", 
      RowBox[{"V", "[", "t", "]"}]}], ",", 
     RowBox[{"v0", "-", 
      RowBox[{"V", "[", "t", "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "16"}], ",", "20"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
