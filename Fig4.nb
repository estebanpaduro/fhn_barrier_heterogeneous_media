 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Case", " ", "1"}], ":", " ", 
    RowBox[{"Additive", " ", "heterogenerity"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Double", " ", "diffusive", " ", "case"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"filenamePrefix", "=", "\"\<Fig4\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pos", "=", "5"}], ";", 
    RowBox[{"width", "=", "4"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Switch", "[", 
         RowBox[{"case", ",", "\[IndentingNewLine]", "1", ",", 
          RowBox[{
           RowBox[{"suffix", "=", "\"\<b.png\>\""}], ";", 
           RowBox[{"p", "=", "0.11"}], ";", 
           RowBox[{"dd2", "=", "1"}], ";"}], ",", "\[IndentingNewLine]", "2", 
          ",", 
          RowBox[{
           RowBox[{"suffix", "=", "\"\<c.png\>\""}], ";", 
           RowBox[{"p", "=", "0.12"}], ";", 
           RowBox[{"dd2", "=", "1"}], ";"}], ",", "\[IndentingNewLine]", "3", 
          ",", 
          RowBox[{
           RowBox[{"suffix", "=", "\"\<d.png\>\""}], ";", 
           RowBox[{"p", "=", "3.7"}], ";", 
           RowBox[{"dd2", "=", "1"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"g", "[", 
          RowBox[{"v_", ",", "x_"}], "]"}], "=", 
         RowBox[{
          RowBox[{"-", "v"}], " ", "*", 
          RowBox[{"Boole", "[", 
           RowBox[{"x", ">", "0"}], "]"}], " ", "*", 
          RowBox[{"Boole", "[", 
           RowBox[{"x", "<", "L"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"mesh", "=", 
         RowBox[{"ToElementMesh", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", "xmin", "}"}], ",", 
              RowBox[{"{", "xmax", "}"}]}], "}"}], "]"}], ",", 
           RowBox[{"MaxCellMeasure", "->", "0.1"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"V1", ",", "W1"}], "}"}], "=", 
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"u", "[", 
                 RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "t"}], "]"}], 
              " ", "==", " ", 
              RowBox[{
               RowBox[{"Laplacian", "[", 
                RowBox[{
                 RowBox[{"u", "[", 
                  RowBox[{"t", ",", "x"}], "]"}], ",", 
                 RowBox[{"{", "x", "}"}]}], "]"}], " ", "+", " ", 
               RowBox[{
                RowBox[{"u", "[", 
                 RowBox[{"t", ",", " ", "x"}], "]"}], 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"u", "[", 
                   RowBox[{"t", ",", "x"}], "]"}]}], ")"}], 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"u", "[", 
                   RowBox[{"t", ",", "x"}], "]"}], "-", "\[Alpha]"}], ")"}]}],
                "-", " ", 
               RowBox[{"w", "[", 
                RowBox[{"t", ",", "x"}], "]"}], "+", 
               RowBox[{"p", " ", 
                RowBox[{"g", "[", 
                 RowBox[{
                  RowBox[{"u", "[", 
                   RowBox[{"t", ",", "x"}], "]"}], ",", "x"}], "]"}]}], "+", 
               RowBox[{"NeumannValue", "[", 
                RowBox[{"0", ",", 
                 RowBox[{
                  RowBox[{"x", "==", "xmin"}], "||", 
                  RowBox[{"x", "==", "xmax"}]}]}], "]"}]}]}], ",", " ", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"\[Tau]", " ", 
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"w", "[", 
                  RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "t"}], 
                "]"}]}], " ", "==", " ", 
              RowBox[{
               RowBox[{"dd2", "  ", 
                RowBox[{"Laplacian", "[", 
                 RowBox[{
                  RowBox[{"w", "[", 
                   RowBox[{"t", ",", "x"}], "]"}], ",", 
                  RowBox[{"{", "x", "}"}]}], "]"}]}], " ", "+", " ", 
               RowBox[{"u", "[", 
                RowBox[{"t", ",", " ", "x"}], "]"}], " ", "-", " ", 
               RowBox[{"\[Gamma]", " ", 
                RowBox[{"w", "[", 
                 RowBox[{"t", ",", " ", "x"}], "]"}]}], "+", 
               RowBox[{"NeumannValue", "[", 
                RowBox[{"0", ",", 
                 RowBox[{
                  RowBox[{"x", "==", "xmin"}], "||", 
                  RowBox[{"x", "==", "xmax"}]}]}], "]"}]}]}], ",", " ", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"u", "[", 
               RowBox[{"0", ",", "x"}], "]"}], "==", 
              RowBox[{"0.5", " ", 
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{"Cos", "[", 
                  RowBox[{"Pi", " ", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"x", "-", "pos"}], ")"}], "/", "width"}]}], 
                  "]"}]}], ")"}], "*", 
               RowBox[{"Boole", "[", 
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"x", "-", "pos"}], "]"}], "<=", "width"}], 
                "]"}]}]}], ",", " ", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"w", "[", 
               RowBox[{"0", ",", " ", "x"}], "]"}], " ", "==", "0"}]}], "}"}],
            ",", "\[IndentingNewLine]", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", "w"}], "}"}], ",", "\[IndentingNewLine]", 
           " ", 
           RowBox[{"{", 
            RowBox[{"t", ",", " ", "0", ",", " ", "maxtime"}], "}"}], ",", 
           " ", "\[IndentingNewLine]", 
           RowBox[{"Element", "[", 
            RowBox[{"x", ",", "mesh"}], "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"Method", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<MethodOfLines\>\"", ",", 
              RowBox[{"\"\<SpatialDiscretization\>\"", "->", 
               RowBox[{"{", "\"\<FiniteElement\>\"", "}"}]}]}], "}"}]}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"g2", "=", 
         RowBox[{"ListLinePlot3D", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
