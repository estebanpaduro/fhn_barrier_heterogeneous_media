                  RowBox[{"t", ",", "x"}], "]"}]}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"x", ",", " ", "xmin", ",", " ", "xmax", ",", "0.2"}],
                 "}"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "0", ",", "maxtime", ",", "25"}], "}"}]}], 
            "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"PlotRange", "->", 
