                  RowBox[{"D2", " ", 
                   RowBox[{"Laplacian", "[", 
                    RowBox[{
                    RowBox[{"w", "[", 
                    RowBox[{"t", ",", "x"}], "]"}], ",", 
                    RowBox[{"{", "x", "}"}]}], "]"}]}], "+", 
                  RowBox[{"u", "[", 
                   RowBox[{"t", ",", "x"}], "]"}], "-", 
                  RowBox[{"\[Gamma]", " ", 
                   RowBox[{"w", "[", 
                    RowBox[{"t", ",", "x"}], "]"}]}], "+", 
                  RowBox[{"NeumannValue", "[", 
                   RowBox[{"0", ",", 
                    RowBox[{
                    RowBox[{"x", "==", "xmin"}], "||", 
                    RowBox[{"x", "==", "xmax"}]}]}], "]"}]}]}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"u", "[", 
                  RowBox[{"0", ",", "x"}], "]"}], "==", 
                 RowBox[{"0.5", " ", 
                  RowBox[{"(", 
                   RowBox[{"1", "+", 
