                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"x", "-", "pos"}], ")"}], "/", "width"}]}], 
                    "]"}]}], ")"}], "*", 
                  RowBox[{"Boole", "[", 
                   RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"x", "-", "pos"}], "]"}], "<=", "width"}], 
                   "]"}]}]}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"w", "[", 
                  RowBox[{"0", ",", "x"}], "]"}], "==", "0"}]}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
