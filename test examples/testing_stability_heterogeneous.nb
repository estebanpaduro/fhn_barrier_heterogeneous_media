Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "4"}], ":", " ", 
    RowBox[{"Test", " ", "With", " ", "a", " ", "traveling", " ", "pulse"}]}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dd1", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"V5", ",", "W5"}], "}"}], "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"u", "[", 
             RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "t"}], "]"}], " ",
           "==", " ", 
          RowBox[{
           RowBox[{"dd1", " ", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"u", "[", 
               RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "x", ",", " ", 
              "x"}], "]"}]}], " ", "+", " ", 
           RowBox[{
            RowBox[{"u", "[", 
             RowBox[{"t", ",", " ", "x"}], "]"}], 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"\[Delta]", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"u", "[", 
                   RowBox[{"t", ",", "x"}], "]"}], "-", "v0"}], ")"}], "^", 
                "2"}]}]}], ")"}]}], " ", "-", 
           RowBox[{
            RowBox[{
             RowBox[{"u", "[", 
              RowBox[{"t", ",", "x"}], "]"}], "^", "3"}], "/", "3"}], " ", "-",
            " ", 
           RowBox[{"w", "[", 
            RowBox[{"t", ",", "x"}], "]"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"w", "[", 
             RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "t"}], "]"}], " ",
           "==", " ", 
          RowBox[{
           RowBox[{"dd2", " ", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"w", "[", 
               RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "x", ",", " ", 
              "x"}], "]"}]}], " ", "+", " ", 
           RowBox[{"ep", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"u", "[", 
               RowBox[{"t", ",", " ", "x"}], "]"}], " ", "-", " ", 
              RowBox[{"\[Gamma]", " ", 
               RowBox[{"w", "[", 
                RowBox[{"t", ",", " ", "x"}], "]"}]}], "+", "\[Beta]"}], 
             ")"}]}]}]}], ",", " ", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"0", ",", " ", "x"}], "]"}], " ", "==", "  ", 
          RowBox[{"V3", "[", 
           RowBox[{"maxtime", ",", "x"}], "]"}]}], ",", " ", 
         RowBox[{"(*", 
          RowBox[{"+", 
           RowBox[{"Which", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"x", "+", "45"}], "]"}], " ", "<=", "1"}], ",", " ", 
             "3", ",", " ", "True", ",", " ", "0"}], "]"}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"t", ",", " ", "xmin"}], "]"}], " ", "==", " ", "v0"}], ",",
          " ", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"t", ",", " ", "xmax"}], "]"}], " ", "==", " ", "v0"}], ",",
          " ", 
         RowBox[{
          RowBox[{"w", "[", 
           RowBox[{"0", ",", " ", "x"}], "]"}], " ", "==", " ", 
          RowBox[{"W3", "[", 
           RowBox[{"maxtime", ",", "x"}], "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"w", "[", 
           RowBox[{"t", ",", " ", "xmin"}], "]"}], " ", "==", " ", "w0"}], ",", 
         RowBox[{
          RowBox[{"w", "[", 
           RowBox[{"t", ",", " ", "xmax"}], "]"}], " ", "==", " ", "w0"}]}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "w"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "maxtime"}], "}"}], ",", " ", 
       RowBox[{"{", 
