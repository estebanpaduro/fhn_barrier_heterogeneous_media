            RowBox[{
             RowBox[{"u", "[", 
              RowBox[{"t", ",", "x"}], "]"}], "^", "3"}], "/", "3"}], " ", "-",
            " ", 
           RowBox[{"w", "[", 
            RowBox[{"t", ",", "x"}], "]"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"w", "[", 
             RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "t"}], "]"}], " ",
           "==", " ", 
          RowBox[{
           RowBox[{"dd2", " ", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"w", "[", 
               RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "x", ",", " ", 
              "x"}], "]"}]}], " ", "+", " ", 
           RowBox[{"ep", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"u", "[", 
