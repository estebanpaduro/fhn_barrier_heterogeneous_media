           RowBox[{
            RowBox[{"u", "[", 
             RowBox[{"t", ",", " ", "x"}], "]"}], 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"\[Delta]", " ", 
               RowBox[{
                RowBox[{"(", 
