Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Comparing", " ", "with", " ", "the", " ", "full", " ", "system"}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"a1", "[", "x_", "]"}], "=", 
     RowBox[{
      RowBox[{"-", "\[Alpha]"}], "+", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{"x", "<", "0"}], ",", 
        RowBox[{
         RowBox[{"2", "v0", 
          RowBox[{"(", 
           RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], "-", 
         RowBox[{"3", 
          RowBox[{"v0", "^", "2"}]}], "-", 
         RowBox[{"3", 
          RowBox[{
           RowBox[{"\[Rho]", "^", "2"}], "/", "2"}]}]}], ",", "True", ",", 
        RowBox[{
         RowBox[{"2", "v0", 
          RowBox[{"(", 
           RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], "-", 
         RowBox[{"3", 
          RowBox[{"v0", "^", "2"}]}], "-", 
         RowBox[{"3", 
          RowBox[{
           RowBox[{"\[Rho]", "^", "2"}], "/", "2"}]}]}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"a2", "[", "x_", "]"}], "=", 
     RowBox[{"1", "+", "\[Alpha]", "+", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{"x", "<", "0"}], ",", "0", ",", "True", ",", 
        RowBox[{
         RowBox[{"-", "3"}], "v0"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"V1", ",", "W1"}], "}"}], "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"u", "[", 
             RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "t"}], "]"}], " ",
           "==", " ", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"u", "[", 
              RowBox[{"t", ",", " ", "x"}], "]"}], ",", " ", "x", ",", " ", 
             "x"}], "]"}], " ", "+", 
           RowBox[{
            RowBox[{"u", "[", 
             RowBox[{"t", ",", "x"}], "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"a1", "[", "x", "]"}], "+", 
              RowBox[{
               RowBox[{"a2", "[", "x", "]"}], " ", 
               RowBox[{"u", "[", 
                RowBox[{"t", ",", "x"}], "]"}]}], "-", 
              RowBox[{
               RowBox[{"u", "[", 
                RowBox[{"t", ",", "x"}], "]"}], "^", "2"}]}], ")"}]}], "-", 
           " ", 
           RowBox[{"w", "[", 
            RowBox[{"t", ",", "x"}], "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"\[Tau]", " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"w", "[", 
              RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}]}], "==", " ", 
          RowBox[{"0.1", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"u", "[", 
              RowBox[{"t", ",", " ", "x"}], "]"}], " ", "-", " ", 
             RowBox[{"\[Gamma]t", " ", 
              RowBox[{"w", "[", 
               RowBox[{"t", ",", " ", "x"}], "]"}]}]}], ")"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"t", ",", " ", "xmin"}], "]"}], " ", "==", " ", "0"}], ",",
          " ", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"t", ",", " ", "xmax"}], "]"}], " ", "==", " ", "0"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"0", ",", " ", "x"}], "]"}], " ", "==", 
          RowBox[{"0", "+", 
           RowBox[{"Which", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"x", "+", "0"}], "]"}], "<", "5"}], ",", 
             RowBox[{"1.15", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"5", "-", 
                 RowBox[{"Abs", "[", 
                  RowBox[{"x", "+", "20"}], "]"}]}], ")"}], "/", "5"}]}], ",",
              "True", ",", "0"}], "]"}]}]}], ",", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{"w", "[", 
           RowBox[{"0", ",", " ", "x"}], "]"}], " ", "==", 
          RowBox[{"0", "/", "\[Gamma]"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "w"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "maxtime"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "xmin", ",", " ", "xmax"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"t", ",", " ", "x"}], "]"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"u", "[", 
         RowBox[{"t", ",", "x"}], "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"t", ",", "x"}], "]"}], "-", "\[Alpha]"}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "\[Alpha]", "-", 
        RowBox[{"3", 
         RowBox[{"u", "[", 
          RowBox[{"t", ",", "x"}], "]"}]}]}], ")"}], 
      RowBox[{
       RowBox[{"\[Rho]", "^", "2"}], "/", "2"}]}], "\[IndentingNewLine]", "+", 
     RowBox[{"NeumannValue", "[", 
      RowBox[{"0", ",", 
       RowBox[{"x", "==", "xmin"}]}], "]"}], "+", 
     RowBox[{"NeumannValue", "[", 
      RowBox[{"0", ",", 
       RowBox[{"x", "==", "xmax"}]}], "]"}]}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Animate", "[", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Plot", "[", 
