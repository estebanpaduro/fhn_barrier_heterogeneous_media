          RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}]}]}], "]"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"V0", "[", "x", "]"}], ",", 
           RowBox[{"-", 
            RowBox[{"V0", "[", "x", "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "40"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"PlotStyle", "->", "Dashed"}]}], "]"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2.2", "-", "v0"}], ",", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"2.2", "-", "v0"}], ")"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xmin", ",", "0"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"PlotStyle", "->", "Dashed"}]}], "]"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "xmax"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Black", ",", "Dashed"}], "}"}]}]}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
