Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Weinberg", "'"}], "s", " ", "parameters"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ep", "=", "0.08"}], ";", 
    RowBox[{"\[Beta]", "=", "0.7"}], ";", 
    RowBox[{"\[Gamma]", "=", "0.8"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Tau]", "=", "142.949"}], ";", 
    RowBox[{"\[Alpha]", "=", "0.129692"}], ";", 
    RowBox[{"\[Gamma]t", "=", "2.7536"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xmin", "=", 
     RowBox[{"-", "50"}]}], ";", 
    RowBox[{"xmax", "=", "50"}], ";", 
    RowBox[{"maxtime", "=", "100"}], ";", " ", 
    RowBox[{"dd1", "=", "1"}], ";", 
