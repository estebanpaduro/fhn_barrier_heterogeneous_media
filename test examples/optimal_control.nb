   RowBox[{"(*", 
    RowBox[{"Additional", " ", "parameters"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Rho]", "=", "0.3"}], ";", 
    RowBox[{"\[Gamma]t", "=", "60"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Check", " ", "condition", " ", "on", " ", "the", " ", "parameters"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqn1", "=", 
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "v"}], 
         RowBox[{"(", 
