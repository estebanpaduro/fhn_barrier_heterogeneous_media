Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Buscamos", " ", "el", " ", "frente", " ", "estacionario", " ", 
    "supersolucion"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"V0", "=", 
    RowBox[{"NDSolveValue", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"v", "''"}], "[", "x", "]"}], "==", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"kappa", "-", 
            RowBox[{"2", "/", "\[Gamma]t"}]}], ")"}], " ", 
          RowBox[{"v", "[", "x", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"v", "[", "0", "]"}], "==", 
         RowBox[{"2.2", "-", "v0"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"v", "'"}], "[", "0", "]"}], "==", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"kappa", "-", 
             RowBox[{"2", "/", "\[Gamma]t"}]}], "]"}]}], 
          RowBox[{"(", 
           RowBox[{"2.2", "-", "v0"}], ")"}]}]}]}], "}"}], ",", "v", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "40"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"V0", "[", "x", "]"}], "+", "v0"}], ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"V0", "[", "x", "]"}]}], "+", "v0"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "40"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
     RowBox[{"Plot", "[", 
      RowBox[{"v0", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "xmax"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Black", ",", "Dashed"}], "}"}]}]}], "]"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"v0", "+", 
          RowBox[{"V0", "[", "x", "]"}]}], ",", 
         RowBox[{"v0", "+", 
          RowBox[{"V0", "[", "x", "]"}]}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"kappa", "-", 
          RowBox[{"2", "/", "\[Gamma]t"}]}], ")"}], " ", 
        RowBox[{"V0", "[", "x", "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "40"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<-f_\[Rho](v1)+v1/\[Gamma]\>\"", 
        ",", "\"\<(kappa-2/\[Gamma]t) v1\>\""}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"v0", "-", 
          RowBox[{"V0", "[", "x", "]"}]}], ",", 
         RowBox[{"v0", "+", 
          RowBox[{"V0", "[", "x", "]"}]}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"kappa", "-", 
          RowBox[{"2", "/", "\[Gamma]t"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"-", 
          RowBox[{"V0", "[", "x", "]"}]}], ")"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "40"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<-f_\[Rho](v2)+v2/\[Gamma]\>\"", 
        ",", "\"\<(kappa-2/\[Gamma]t) v2\>\""}], "}"}]}]}], 
    "]"}]}]}]], "Input",
