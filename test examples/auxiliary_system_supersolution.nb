Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Maximum", " ", "of", " ", "the", " ", "quadratic", " ", "polynomial", " ",
     "with", " ", "coefficientes", " ", "P1", " ", "and", " ", "P2"}], "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"a1", "[", "x_", "]"}], "=", 
     RowBox[{
      RowBox[{"-", "\[Alpha]"}], "+", 
      RowBox[{"2", 
       RowBox[{"V2", "[", 
        RowBox[{"maxtime", ",", "x"}], "]"}], 
       RowBox[{"(", 
        RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], "-", 
      RowBox[{"3", 
       RowBox[{
        RowBox[{"V2", "[", 
         RowBox[{"maxtime", ",", "x"}], "]"}], "^", "2"}]}], "-", 
      RowBox[{"3", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Rho]", "[", "x", "]"}], "^", "2"}], "/", "2"}]}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"a2", "[", "x_", "]"}], "=", 
     RowBox[{"1", "+", "\[Alpha]", "-", 
      RowBox[{"3", 
       RowBox[{"V2", "[", 
        RowBox[{"maxtime", ",", "x"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "the", " ", "maximum", " ", "of", " ", "a", " ", "quadratic", " ", "is", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"4", "ac"}], "-", 
        RowBox[{"b", "^", "2"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"4", "a"}], ")"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g1", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"4", 
           RowBox[{"a1", "[", "x", "]"}]}], "+", 
          RowBox[{
           RowBox[{"a2", "[", "x", "]"}], "^", "2"}]}], ")"}], "/", "4"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g2", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"-", "0.5"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "0.35"}], ",", "0.35"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Orange"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"g1", ",", "g2"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a1", "[", "x", "]"}], ",", 
       RowBox[{"a2", "[", "x", "]"}], ",", 
       RowBox[{"V2", "[", 
        RowBox[{"maxtime", ",", "x"}], "]"}], ",", 
       RowBox[{
        RowBox[{"\[Rho]", "[", "x", "]"}], "^", "2"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
     RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}]}]}]], "Input",
