       RowBox[{"\"\<PDEDiscretization\>\"", "->", "\"\<FiniteElement\>\""}], 
       "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", "V6b", "}"}], "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0", "==", 
        RowBox[{
         RowBox[{"dd1", " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"u", "[", " ", "x", "]"}], ",", " ", "x", ",", " ", "x"}],
            "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"u", "[", "x", "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"a1", "[", "x", "]"}], "-", 
            RowBox[{
             RowBox[{"a2", "[", "x", "]"}], 
             RowBox[{"u", "[", "x", "]"}]}], "-", 
            RowBox[{
             RowBox[{"u", "[", "x", "]"}], "^", "2"}]}], ")"}]}], "+", 
         RowBox[{
          RowBox[{"u", "[", "x", "]"}], "/", "\[Gamma]t"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"u", "[", "LL", "]"}], " ", "==", "valueLL"}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"u", "[", "10", "]"}], " ", "==", "0.001"}]}], "}"}], ",", 
     " ", 
     RowBox[{"{", "u", "}"}], ",", " ", 
     RowBox[{"{", 
