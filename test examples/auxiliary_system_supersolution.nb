Cell[BoxData[{
 RowBox[{"startPoint", "=", 
  RowBox[{
   RowBox[{"-", "LL"}], "+", "0.5"}]}], "\[IndentingNewLine]", 
 RowBox[{"valuestartPoint", "=", "1"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"valueLL", "=", "0.05"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", "V6a", "}"}], "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0", "==", 
        RowBox[{
         RowBox[{"dd1", " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"u", "[", " ", "x", "]"}], ",", " ", "x", ",", " ", "x"}],
            "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"u", "[", "x", "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"a1", "[", "x", "]"}], "-", 
            RowBox[{
             RowBox[{"a2", "[", "x", "]"}], 
             RowBox[{"u", "[", "x", "]"}]}], "-", 
            RowBox[{
             RowBox[{"u", "[", "x", "]"}], "^", "2"}]}], ")"}]}], "+", 
         RowBox[{
          RowBox[{"u", "[", "x", "]"}], "/", "\[Gamma]t"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"u", "[", "startPoint", "]"}], " ", "==", "valuestartPoint"}],
        ",", " ", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"u", "[", "LL", "]"}], " ", "==", "valueLL"}]}], "}"}], ",", 
     " ", 
     RowBox[{"{", "u", "}"}], ",", " ", 
     RowBox[{"{", 
