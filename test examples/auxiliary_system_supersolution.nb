     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<PDEDiscretization\>\"", "->", "\"\<FiniteElement\>\""}], 
       "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Which", "[", 
     RowBox[{
