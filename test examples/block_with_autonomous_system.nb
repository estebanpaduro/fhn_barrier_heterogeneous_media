    ";"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[Rho]", "[", "x", "]"}], "^", "2"}], "/", "2"}], ",", 
       RowBox[{"\[Delta]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"V5", "[", 
            RowBox[{"maxtime", ",", "x"}], "]"}], "-", "v0"}], ")"}], "^", 
         "2"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "20"}], ",", "20"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "6"}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"V5", "[", 
        RowBox[{"maxtime", ",", "x"}], "]"}], ",", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"V5", "[", 
          RowBox[{"maxtime", ",", "x"}], "]"}], "-", 
         RowBox[{"V3", "[", 
          RowBox[{"maxtime", ",", "x"}], "]"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "20"}], ",", "20"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1.2"}], ",", "0"}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{"V5", "[", 
