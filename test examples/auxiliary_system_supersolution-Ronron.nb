       RowBox[{"a2", "[", "x", "]"}], ",", 
       RowBox[{"V2", "[", 
        RowBox[{"maxtime", ",", "x"}], "]"}], ",", 
       RowBox[{
        RowBox[{"\[Rho]", "[", "x", "]"}], "^", "2"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
     RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}]}]}]], "Input",
