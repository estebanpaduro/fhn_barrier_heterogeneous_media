Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"K", "=", "1.2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mmin", "=", 
   RowBox[{"-", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mmax", "=", 
   RowBox[{"-", "0.1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"j", "=", "0"}], ",", 
   RowBox[{"j", "<", "10"}], ",", 
   RowBox[{"j", "=", 
    RowBox[{"j", "+", "1"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"m", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"mmax", "+", "mmin"}], ")"}], "/", "2"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"bmax", "=", "5"}], ";", 
    RowBox[{"bmin", "=", "0.8"}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"k", "=", "0"}], ",", 
      RowBox[{"k", "<", "20"}], ",", 
      RowBox[{"k", "=", 
       RowBox[{"k", "+", "1"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Beta]", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"bmax", "+", "bmin"}], ")"}], "/", "2"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"V1", ",", "U1"}], "}"}], "=", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"v", "'"}], "[", "x", "]"}], "==", 
             RowBox[{"u", "[", "x", "]"}]}], ",", 
            RowBox[{
             RowBox[{"r1", " ", 
              RowBox[{
               RowBox[{"u", "'"}], "[", "x", "]"}]}], "==", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"f", "[", 
                RowBox[{"v", "[", "x", "]"}], "]"}]}], "-", 
              RowBox[{"\[Sigma]", " ", 
               RowBox[{
                RowBox[{"v", "[", "x", "]"}], "/", "\[Gamma]"}]}]}]}], ",", 
            RowBox[{
             RowBox[{"v", "[", 
              RowBox[{"-", "\[Beta]"}], "]"}], "==", "K"}], ",", 
            RowBox[{
             RowBox[{"u", "[", 
              RowBox[{"-", "\[Beta]"}], "]"}], "==", "m"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"v", ",", "w"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"-", "\[Beta]"}], ",", "0"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"V1", "[", "0", "]"}], ">", "smallroot"}], ",", 
         RowBox[{"bmin", "=", "\[Beta]"}], ",", 
         RowBox[{"bmax", "=", "\[Beta]"}]}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"\[Beta]", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"bmax", "+", "bmin"}], ")"}], "/", "2"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Best \[Beta]: \>\"", ",", "\[Beta]"}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"V1", ",", "U1"}], "}"}], "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"v", "'"}], "[", "x", "]"}], "==", 
          RowBox[{"u", "[", "x", "]"}]}], ",", 
         RowBox[{
          RowBox[{"r1", " ", 
           RowBox[{
            RowBox[{"u", "'"}], "[", "x", "]"}]}], "==", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"f", "[", 
             RowBox[{"v", "[", "x", "]"}], "]"}]}], "-", 
           RowBox[{"\[Sigma]", " ", 
            RowBox[{
             RowBox[{"v", "[", "x", "]"}], "/", "\[Gamma]"}]}]}]}], ",", 
         RowBox[{
          RowBox[{"v", "[", 
           RowBox[{"-", "\[Beta]"}], "]"}], "==", "K"}], ",", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"-", "\[Beta]"}], "]"}], "==", "m"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "w"}], "}"}], ",", 
