        RowBox[{"x", ",", 
         RowBox[{"-", "\[Beta]"}], ",", "0"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"xstarmax", "=", "1"}], ";", "\[IndentingNewLine]", 
    RowBox[{"xstarmin", "=", "0"}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"k", "=", "0"}], ",", 
      RowBox[{"k", "<", "20"}], ",", 
      RowBox[{"k", "=", 
       RowBox[{"k", "+", "1"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"xstar", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"xstarmax", "+", "xstarmin"}], ")"}], "/", "2"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"V2", ",", "U2"}], "}"}], "=", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"v", "'"}], "[", "x", "]"}], "==", 
             RowBox[{"u", "[", "x", "]"}]}], ",", 
            RowBox[{
             RowBox[{"r2", " ", 
              RowBox[{
               RowBox[{"u", "'"}], "[", "x", "]"}]}], "==", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"f", "[", 
                RowBox[{"v", "[", "x", "]"}], "]"}]}], "-", 
              RowBox[{"\[Sigma]", " ", 
               RowBox[{
                RowBox[{"v", "[", "x", "]"}], "/", "\[Gamma]"}]}]}]}], ",", 
            RowBox[{
             RowBox[{"v", "[", "0", "]"}], "==", "smallroot"}], ",", 
            RowBox[{
             RowBox[{"u", "[", "0", "]"}], "==", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"r1", "^", "2"}], "/", 
                RowBox[{"r2", "^", "2"}]}], ")"}], " ", 
              RowBox[{
               RowBox[{"V1", "'"}], "[", "0", "]"}]}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"v", ",", "w"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", "xstar"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"V2", "[", "xstar", "]"}], ">", "vinf"}], ",", 
         RowBox[{"xstarmin", "=", "xstar"}], ",", 
         RowBox[{"xstarmax", "=", "xstar"}]}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"xstar", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"xstarmax", "+", "xstarmin"}], ")"}], "/", "2"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Best xstar: \>\"", ",", "xstar"}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"V2", ",", "U2"}], "}"}], "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"v", "'"}], "[", "x", "]"}], "==", 
          RowBox[{"u", "[", "x", "]"}]}], ",", 
         RowBox[{
          RowBox[{"r2", " ", 
           RowBox[{
            RowBox[{"u", "'"}], "[", "x", "]"}]}], "==", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"f", "[", 
             RowBox[{"v", "[", "x", "]"}], "]"}]}], "-", 
           RowBox[{"\[Sigma]", " ", 
            RowBox[{
             RowBox[{"v", "[", "x", "]"}], "/", "\[Gamma]"}]}]}]}], ",", 
         RowBox[{
          RowBox[{"v", "[", "0", "]"}], "==", "smallroot"}], ",", 
         RowBox[{
          RowBox[{"u", "[", "0", "]"}], "==", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"r1", "^", "2"}], "/", 
             RowBox[{"r2", "^", "2"}]}], ")"}], " ", 
           RowBox[{
            RowBox[{"V1", "'"}], "[", "0", "]"}]}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "w"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "xstar"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"V2", "'"}], "[", "xstar", "]"}], ">", "0"}], ",", 
      RowBox[{"mmax", "=", "m"}], ",", 
      RowBox[{"mmin", "=", "m"}]}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{
      RowBox[{"V2", "'"}], "[", "xstar", "]"}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
