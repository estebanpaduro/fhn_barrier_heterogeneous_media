Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Simulacion", " ", "en", " ", "parametrizaci\[OAcute]n", " ", "centrada"}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"A", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", "v0"}], "+", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"12", " ", "\[Delta]"}], "-", 
          RowBox[{"3", 
           RowBox[{"v0", "^", "2"}]}]}], "]"}]}], ")"}], "/", 
