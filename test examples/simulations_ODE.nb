Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Simulacion", " ", "de", " ", "FHN", " ", "ODE", " ", "con", " ", "la", " ",
     "parametrizacion", " ", "usual"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"eqn", "=", " ", 
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[Delta]", " ", "v"}], "-", 
         RowBox[{
          RowBox[{"v", "^", "3"}], "/", "3"}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"v", "+", "\[Beta]"}], ")"}], "/", "\[Gamma]"}]}], "==", 
        "0"}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v0", ",", "w0"}], "}"}], "=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"v", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"v", "+", "\[Beta]"}], ")"}], "/", "\[Gamma]"}]}], "}"}], "/.",
       "eqn"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{
     RowBox[{"v0", "^", "2"}], "/", "4"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"V1", ",", "W1"}], "}"}], "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"v", "'"}], "[", "t", "]"}], "==", 
          RowBox[{
           RowBox[{"\[Delta]", " ", 
            RowBox[{"v", "[", "t", "]"}]}], "-", 
           RowBox[{
            RowBox[{
             RowBox[{"v", "[", "t", "]"}], "^", "3"}], "/", "3"}], "-", 
           RowBox[{"w", "[", "t", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"w", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"ep", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"v", "[", "t", "]"}], " ", "-", " ", 
             RowBox[{"\[Gamma]", " ", 
              RowBox[{"w", "[", "t", "]"}]}], "+", "\[Beta]"}], ")"}]}]}], ",", 
         RowBox[{
          RowBox[{"v", "[", "0", "]"}], "==", 
          RowBox[{"v0", "+", "1"}]}], ",", 
         RowBox[{
          RowBox[{"w", "[", "0", "]"}], "==", 
          RowBox[{"w0", "+", "0.1"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "w"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "maxtime"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"V1", "[", "t", "]"}], ",", 
       RowBox[{"W1", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "maxtime"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "2.5"}], ",", "2"}], "}"}]}]}], "]"}]}]}]], "Input",
