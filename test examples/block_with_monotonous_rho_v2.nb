Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{"-", "0.4"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"alph", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"initialSlope", "=", "0.335"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"innerRegion", "=", "0.4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"g0", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Which", "[", 
     RowBox[{
      RowBox[{"x", ">", "p"}], ",", 
      RowBox[{"initialSlope", " ", 
       RowBox[{"(", 
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", "alph", "]"}]}], ")"}], 
       RowBox[{"Sinh", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", "alph", "]"}], 
         RowBox[{"(", 
          RowBox[{"x", "-", "p"}], ")"}]}], "]"}]}], ",", "True", ",", "0"}], 
     "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "innerRegion"}], ",", "innerRegion"}], "}"}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g1", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"initialSlope", " ", 
        RowBox[{"(", 
         RowBox[{"1", "/", 
          RowBox[{"Sqrt", "[", "alph", "]"}]}], ")"}], 
        RowBox[{"Sinh", "[", 
         RowBox[{
          RowBox[{"Sqrt", "[", "alph", "]"}], 
          RowBox[{"(", 
           RowBox[{"x", "-", "p"}], ")"}]}], "]"}]}], ",", 
       RowBox[{"initialSlope", " ", 
        RowBox[{"Cosh", "[", 
         RowBox[{
          RowBox[{"Sqrt", "[", "alph", "]"}], 
          RowBox[{"(", 
           RowBox[{"x", "-", "p"}], ")"}]}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "p", ",", "innerRegion"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1.2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1.5"}], "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Ux", ",", "Vx"}], "}"}], "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"u", "'"}], "[", "x", "]"}]}], "==", 
        RowBox[{"v", "[", "x", "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"v", "'"}], "[", "x", "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "x", "]"}], "^", "2"}], 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"u", "[", "x", "]"}]}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"u", "[", "0", "]"}], "==", "0.99"}], ",", 
       RowBox[{
        RowBox[{"v", "[", "0", "]"}], "==", "0.015"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", "v"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "6"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g2", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Ux", "[", "x", "]"}], ",", 
       RowBox[{"Vx", "[", "x", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "6"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1.2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1.5"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "->", "Orange"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"g1", ",", "g2"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Ux2", ",", "Vx2"}], "}"}], "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"u", "'"}], "[", "x", "]"}], "==", 
        RowBox[{"v", "[", "x", "]"}]}], ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"v", "'"}], "[", "x", "]"}]}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "x", "]"}], "^", "2"}], 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"u", "[", "x", "]"}]}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"u", "[", "0", "]"}], "==", 
        RowBox[{"initialSlope", " ", 
         RowBox[{"(", 
          RowBox[{"1", "/", 
           RowBox[{"Sqrt", "[", "alph", "]"}]}], ")"}], 
         RowBox[{"Sinh", "[", 
          RowBox[{
           RowBox[{"Sqrt", "[", "alph", "]"}], 
           RowBox[{"(", 
            RowBox[{"innerRegion", "-", "p"}], ")"}]}], "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"v", "[", "0", "]"}], "==", 
        RowBox[{"initialSlope", " ", 
         RowBox[{"Cosh", "[", 
          RowBox[{
           RowBox[{"Sqrt", "[", "alph", "]"}], 
           RowBox[{"(", 
            RowBox[{"innerRegion", "-", "p"}], ")"}]}], "]"}]}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", "v"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "6"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vv", "[", "x_", "]"}], "=", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{"x", "<", "p"}], ",", "0", ",", 
     RowBox[{"x", "<", "innerRegion"}], ",", 
     RowBox[{"initialSlope", " ", 
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"Sqrt", "[", "alph", "]"}]}], ")"}], 
      RowBox[{"Sinh", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", "alph", "]"}], 
        RowBox[{"(", 
         RowBox[{"x", "-", "p"}], ")"}]}], "]"}]}], ",", "True", ",", 
