         RowBox[{"u", ",", "v"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "simulationTime2"}], "}"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"g1d", "=", 
      RowBox[{"ParametricPlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Ux4", "[", "x", "]"}], ",", 
          RowBox[{"Vx4", "[", "x", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "simulationTime2"}], "}"}], ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1.1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "0.1"}], ",", "0.4"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Show", "[", 
       RowBox[{
       "g1", ",", "g3", ",", "g1b", ",", "g2", ",", "g3b", ",", "g1c", ",", 
        "g3c", ",", "g1d", ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1.1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "0.1"}], ",", "0.6"}], "}"}]}], "}"}]}]}], "]"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"g0", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{"x", "<", "startTime"}], ",", 
           RowBox[{"Ux0", "[", "x", "]"}], ",", 
           RowBox[{"x", "<", 
            RowBox[{"startTime", "+", "gapLength"}]}], ",", 
           RowBox[{"Ux3", "[", 
            RowBox[{"x", "-", "startTime"}], "]"}], ",", 
           RowBox[{"x", "<", 
            RowBox[{"startTime", "+", "gapLength", "+", "simulationTime2"}]}],
            ",", 
           RowBox[{"Ux4", "[", 
            RowBox[{"x", "-", 
             RowBox[{"(", 
              RowBox[{"startTime", "+", "gapLength"}], ")"}]}], "]"}], ",", 
           "True", ",", "1"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", 
           RowBox[{
           "startTime", "+", "gapLength", "+", "simulationTime2", "+", 
            "1"}]}], "}"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"lines", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{"Gray", ",", "Dashed", ",", "Thick"}], "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"startTime", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"startTime", ",", "1"}], "}"}]}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Directive", "[", 
          RowBox[{"Gray", ",", "Dashed", ",", "Thick"}], "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"startTime", "+", "gapLength"}], ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"startTime", "+", "gapLength"}], ",", "1"}], "}"}]}], 
           "}"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Directive", "[", 
          RowBox[{"Gray", ",", "Dashed", ",", "Thick"}], "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"startTime", "+", "gapLength", "+", "simulationTime2"}],
               ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"startTime", "+", "gapLength", "+", "simulationTime2"}],
               ",", "1"}], "}"}]}], "}"}], "]"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Show", "[", 
      RowBox[{"g0", ",", "lines"}], "]"}]}], "\[IndentingNewLine]", 
    "*)"}]}]}]], "Input",
