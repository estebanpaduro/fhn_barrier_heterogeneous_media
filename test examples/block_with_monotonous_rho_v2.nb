Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "P1", " ", "and", " ", "P2", " ", "are", " ", "the", " ", "root", " ", 
    "in", " ", "the", " ", "factorization", " ", "after", " ", "the", " ", 
    "change", " ", "of", " ", "variables"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"g", "[", "x_", "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "\[Alpha]", "-", 
         RowBox[{"3", 
          RowBox[{"V2", "[", 
           RowBox[{"maxtime", ",", "x"}], "]"}]}]}], ")"}], "^", "2"}], "-", 
      RowBox[{"4", 
       RowBox[{"(", 
        RowBox[{"\[Alpha]", "+", 
         RowBox[{"3", 
          RowBox[{
           RowBox[{"V2", "[", 
            RowBox[{"maxtime", ",", "x"}], "]"}], "^", "2"}]}], "-", 
         RowBox[{"2", 
          RowBox[{"(", 
           RowBox[{"1", "+", "\[Alpha]"}], " ", ")"}], 
          RowBox[{"V2", "[", 
           RowBox[{"maxtime", ",", "x"}], "]"}]}], "+", 
         RowBox[{"3", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Rho]", "[", "x", "]"}], "^", "2"}], "/", "2"}]}]}], 
        ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"p1", "[", "x_", "]"}], "=", 
     RowBox[{
      RowBox[{"0.5", 
       RowBox[{"(", 
        RowBox[{"1", "+", "\[Alpha]", "-", 
         RowBox[{"3", 
          RowBox[{"V2", "[", 
           RowBox[{"maxtime", ",", "x"}], "]"}]}]}], ")"}]}], "+", 
      RowBox[{"0.5", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", "\[Alpha]", "-", 
            RowBox[{"3", 
             RowBox[{"V2", "[", 
              RowBox[{"maxtime", ",", "x"}], "]"}]}]}], ")"}], "^", "2"}], 
         "-", 
         RowBox[{"4", 
          RowBox[{"(", 
           RowBox[{"\[Alpha]", "+", 
            RowBox[{"3", 
             RowBox[{
              RowBox[{"V2", "[", 
               RowBox[{"maxtime", ",", "x"}], "]"}], "^", "2"}]}], "-", 
            RowBox[{"2", 
             RowBox[{"(", 
              RowBox[{"1", "+", "\[Alpha]"}], " ", ")"}], 
             RowBox[{"V2", "[", 
              RowBox[{"maxtime", ",", "x"}], "]"}]}], "+", 
            RowBox[{"3", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Rho]", "[", "x", "]"}], "^", "2"}], "/", "2"}]}]}], 
           ")"}]}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"p2", "[", "x_", "]"}], "=", 
     RowBox[{
      RowBox[{"0.5", 
       RowBox[{"(", 
        RowBox[{"1", "+", "\[Alpha]", "-", 
         RowBox[{"3", 
          RowBox[{"V2", "[", 
           RowBox[{"maxtime", ",", "x"}], "]"}]}]}], ")"}]}], "-", 
      RowBox[{"0.5", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", "\[Alpha]", "-", 
            RowBox[{"3", 
             RowBox[{"V2", "[", 
              RowBox[{"maxtime", ",", "x"}], "]"}]}]}], ")"}], "^", "2"}], 
         "-", 
         RowBox[{"4", 
          RowBox[{"(", 
           RowBox[{"\[Alpha]", "+", 
            RowBox[{"3", 
             RowBox[{
              RowBox[{"V2", "[", 
               RowBox[{"maxtime", ",", "x"}], "]"}], "^", "2"}]}], "-", 
            RowBox[{"2", 
