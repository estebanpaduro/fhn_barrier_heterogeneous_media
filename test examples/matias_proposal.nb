Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"V1c", ",", "V2c"}], "}"}], "=", 
    RowBox[{"NDSolveValue", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"v1", "''"}], "[", "x", "]"}], "==", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"f", "[", 
            RowBox[{"v1", "[", "x", "]"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"v2", "[", "x", "]"}], "/", "\[Gamma]t"}]}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"v2", "''"}], "[", "x", "]"}], "==", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"f", "[", 
            RowBox[{"v2", "[", "x", "]"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"v1", "[", "x", "]"}], "/", "\[Gamma]t"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"v1", "[", "leftBoundaryTime", "]"}], "==", 
         RowBox[{"-", 
          RowBox[{"V2b", "[", "leftBoundaryTime", "]"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"v1", "'"}], "[", "leftBoundaryTime", "]"}], "==", "0"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"v2", "[", "leftBoundaryTime", "]"}], "==", 
         RowBox[{"V2b", "[", "leftBoundaryTime", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"v2", "'"}], "[", "leftBoundaryTime", "]"}], "==", "0"}]}], 
       "\[IndentingNewLine]", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"v1", ",", "v2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "leftBoundaryTime2", ",", "leftBoundaryTime"}], 
       "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"ParametricPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"V", "[", "x", "]"}], ",", 
        RowBox[{"U", "[", "x", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "5"}], ",", "3"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "0.2"}], ",", "0.2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "0.2"}], ",", "0.2"}], "}"}]}], "}"}]}]}], "]"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g1", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"V1", "[", "x", "]"}], ",", 
         RowBox[{
          RowBox[{"-", "\[Delta]"}], " ", 
          RowBox[{"V1", "[", "x", "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "switchingTime", ",", "maxtime2"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g2", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"V1b", "[", "x", "]"}], ",", 
         RowBox[{"V2b", "[", "x", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "leftBoundaryTime", ",", "switchingTime"}], "}"}]}],
       "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g3", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"V1c", "[", "x", "]"}], ",", 
         RowBox[{"-", 
          RowBox[{"V1c", "[", "x", "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "leftBoundaryTime2", ",", "leftBoundaryTime"}], 
        "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"labels", "=", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"Text", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<-\!\(\*UnderscriptBox[\(v\), \(\[UnderBracket]\)]\) = \
\!\(\*OverscriptBox[\(v\), \(_\)]\) \\n \!\(\*UnderscriptBox[\(v\), \(\
\[UnderBracket]\)]\)'[p] = \!\(\*OverscriptBox[\(v\), \(_\)]\) '[p]=0\>\"", ",", 
           RowBox[{"FontSize", "->", "14"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "4"}], ",", "0.3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
       "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"g1", ",", "g2", ",", "g3", ",", "labels", ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}]], "Input",
