Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"V1b", ",", "V2b"}], "}"}], "=", 
    RowBox[{"NDSolveValue", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"v1", "''"}], "[", "x", "]"}], "==", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"f", "[", 
            RowBox[{"v1", "[", "x", "]"}], "]"}]}], "+", " ", 
          RowBox[{
           RowBox[{"v2", "[", "x", "]"}], "/", "\[Gamma]t"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"v2", "''"}], "[", "x", "]"}], "==", "0"}], ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"f", "[", 
             RowBox[{"v2", "[", "x", "]"}], "]"}]}], "+", 
           RowBox[{"0.2", 
            RowBox[{
             RowBox[{"v1", "[", "x", "]"}], "/", "\[Gamma]t"}]}]}], ","}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"v1", "[", "switchingTime", "]"}], "==", 
         RowBox[{"V1", "[", "switchingTime", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"v2", "[", "switchingTime", "]"}], "==", 
