Cell[BoxData[{
 RowBox[{
  RowBox[{"g1", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{
        RowBox[{"-", "\[Gamma]t"}], " ", 
        RowBox[{"f", "[", "x", "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1.5"}], "}"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<\!\(\*OverscriptBox[\(v\), \(_\)]\)\>\"", 
        ",", "\"\<-\!\(\*UnderscriptBox[\(v\), \(\[UnderBracket]\)]\)\>\""}], 
       "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g2", "=", 
