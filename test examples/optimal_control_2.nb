    RowBox[{"\[Gamma]t", "=", "2.7536"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xmin", "=", 
     RowBox[{"-", "50"}]}], ";", 
    RowBox[{"xmax", "=", "50"}], ";", 
    RowBox[{"maxtime", "=", "100"}], ";", " ", 
    RowBox[{"dd1", "=", "1"}], ";", 
    RowBox[{"dd2", "=", "0.001"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Additional", " ", "parameters"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Rho]", "=", "0.3"}], ";", 
    RowBox[{"kappa", "=", "0.038"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"\[Gamma]t", "=", "60"}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Check", " ", "condition", " ", "on", " ", "the", " ", "parameters"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqn1", "=", 
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "v"}], 
         RowBox[{"(", 
