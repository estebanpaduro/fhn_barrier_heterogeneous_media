          RowBox[{"\[Rho]", "^", "2"}], "/", "2"}]}], "+", 
        RowBox[{"v", "/", "\[Gamma]t"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0.9"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"v0", "=", 
    RowBox[{"v", "/.", "eqn1"}]}]}]}]], "Input",
