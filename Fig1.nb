            RowBox[{"v", "[", "x", "]"}], "]"}], "-", 
           RowBox[{
            RowBox[{"v", "[", "x", "]"}], "/", "\[Gamma]"}]}]}], ",", 
         RowBox[{
          RowBox[{"v", "[", "0", "]"}], "==", 
          RowBox[{"V1", "[", "0", "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"v", "'"}], "[", "0", "]"}], "==", 
          RowBox[{
           RowBox[{
            RowBox[{"V1", "'"}], "[", "0", "]"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "+", "p1"}], ")"}], "^", "2"}], "-", "1"}], 
             ")"}], 
            RowBox[{
             RowBox[{"V1", "'"}], "[", "0", "]"}]}]}]}]}], "}"}], ",", "v", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "10"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqnx0", "=", 
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"V3", "[", "x", "]"}], "==", "K"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "1"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x0", "=", 
     RowBox[{"x", "/.", "eqnx0"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Parameter x0 calculated with numerical solution of V3: \>\"",
       ",", "x0"}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"VV", "[", "x_", "]"}], "=", 
     RowBox[{"Piecewise", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
