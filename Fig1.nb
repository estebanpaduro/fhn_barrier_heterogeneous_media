     RowBox[{"the", " ", "approach"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"valuek", "=", 
     RowBox[{"0.9", 
      RowBox[{"Min", "[", 
       RowBox[{"1", ",", "maxValuek"}], "]"}]}]}], ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vinf", "=", 
     RowBox[{"0.2", "valuek"}]}], ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Value of vinf used: \>\"", ",", "vinf"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"V1", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"sg1", " ", 
           RowBox[{
            RowBox[{"v", "''"}], "[", "x", "]"}]}], "==", 
          RowBox[{"Piecewise", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"h", "[", 
                 RowBox[{"v", "[", "x", "]"}], "]"}], "-", 
                RowBox[{
                 RowBox[{"v", "[", "x", "]"}], "/", "\[Gamma]"}]}], ",", 
               RowBox[{
                RowBox[{"v", "[", "x", "]"}], ">", 
                RowBox[{"vinf", "+", 
                 RowBox[{"10", "^", 
                  RowBox[{"(", 
                   RowBox[{"-", "5"}], ")"}]}]}]}]}], "}"}], "}"}], ",", 
            "0"}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"v", "[", "0", "]"}], "==", "valuek"}], ",", 
         "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"v", "'"}], "[", "0", "]"}], "==", 
          RowBox[{
           RowBox[{"Sqrt", "[", "2", "]"}], 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "/", "sg1"}], ")"}], 
             RowBox[{"Integrate", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"h", "[", "u", "]"}], "-", 
                RowBox[{"u", "/", "\[Gamma]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"u", ",", "vinf", ",", "valuek"}], "}"}]}], "]"}]}], 
            "]"}]}]}]}], "\[IndentingNewLine]", "}"}], ",", 
       "\[IndentingNewLine]", "v", ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "10"}], ",", "0"}], "}"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "2"}], ":", " ", 
     RowBox[{"The", " ", "climb"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "We", " ", "compute", " ", "the", " ", "change", " ", "on", " ", "the", " ",
      "slope", " ", "required", " ", "on", " ", "step", " ", "3"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"boundDerivativeV3Squared", "[", "p_", "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "p"}], ")"}], "^", "4"}], 
      RowBox[{
       RowBox[{
        RowBox[{"V1", "'"}], "[", "0", "]"}], "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"requiredSlopeSquared", "[", "p_", "]"}], "=", 
     RowBox[{
      RowBox[{"-", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "p"}], ")"}]}], "2", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"h", "[", "v", "]"}], "-", 
         RowBox[{"v", "/", "\[Gamma]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"v", ",", "maxValuek", " ", ",", "v0"}], "}"}]}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqnp", "=", 
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"boundDerivativeV3Squared", "[", "p", "]"}], "==", 
        RowBox[{"requiredSlopeSquared", "[", "p", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"p", ",", "6"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Parameter p estimated with integral formula: \>\"", ",", 
      RowBox[{"Replace", "[", 
       RowBox[{"p", ",", "eqnp"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p1", "=", 
     RowBox[{
      RowBox[{"Replace", "[", 
       RowBox[{"p", ",", "eqnp"}], "]"}], "+", "0.1"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "3"}], ":", " ", 
     RowBox[{"The", " ", "Summit"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sg3", "=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", "p1"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"V3", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"sg3", " ", 
           RowBox[{
            RowBox[{"v", "''"}], "[", "x", "]"}]}], "==", 
