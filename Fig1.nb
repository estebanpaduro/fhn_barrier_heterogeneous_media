            RowBox[{"v", "''"}], "[", "x", "]"}]}], "==", 
          RowBox[{
           RowBox[{"h", "[", 
            RowBox[{"v", "[", "x", "]"}], "]"}], "-", 
           RowBox[{
            RowBox[{"v", "[", "x", "]"}], "/", "\[Gamma]"}]}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"v", "[", "0", "]"}], "==", 
          RowBox[{"V1", "[", "0", "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"v", "'"}], "[", "0", "]"}], "==", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"sg1", "^", "2"}], "/", 
             RowBox[{"sg2", "^", "2"}]}], ")"}], 
           RowBox[{
            RowBox[{"V1", "'"}], "[", "0", "]"}]}]}]}], "\[IndentingNewLine]",
         "}"}], ",", "\[IndentingNewLine]", "v", ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "25"}], "}"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqn3", "=", 
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"V2", "[", "x", "]"}], "==", "valueTildek"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "1"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L", "=", 
     RowBox[{"x", "/.", "eqn3"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "3"}], ":", " ", 
     RowBox[{"The", " ", "Summit"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"V3", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"sg3", " ", 
           RowBox[{
            RowBox[{"v", "''"}], "[", "x", "]"}]}], "==", 
          RowBox[{
           RowBox[{"h", "[", 
            RowBox[{"v", "[", "x", "]"}], "]"}], "-", 
           RowBox[{
            RowBox[{"v", "[", "x", "]"}], "/", "\[Gamma]"}]}]}], ",", 
         RowBox[{
          RowBox[{"v", "[", "L", "]"}], "==", 
          RowBox[{"V2", "[", "L", "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"v", "'"}], "[", "L", "]"}], "==", 
          RowBox[{
           RowBox[{
            RowBox[{"V2", "'"}], "[", "L", "]"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"sg2", "^", "2"}], "/", 
             RowBox[{"sg3", "^", "2"}]}], ")"}]}]}]}], "}"}], ",", "v", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "L", ",", 
         RowBox[{"L", "+", "10"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqnx0", "=", 
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"V3", "[", "x", "]"}], "==", "K"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"L", "+", "1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x0", "=", 
     RowBox[{"x", "/.", "eqnx0"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Parameter x0 calculated with numerical solution of V3: \>\"",
       ",", "x0"}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"VV", "[", "x_", "]"}], "=", 
     RowBox[{"Piecewise", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"V1", "[", "x", "]"}], ",", 
           RowBox[{"x", "<", "0"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"V2", "[", "x", "]"}], ",", 
           RowBox[{
            RowBox[{"x", ">=", "0"}], "&&", 
            RowBox[{"x", "<", "L"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"V3", "[", "x", "]"}], ",", 
           RowBox[{
            RowBox[{"x", ">=", "L"}], "&&", 
            RowBox[{"x", "<", "x0"}]}]}], "}"}]}], "}"}], ",", "K"}], "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"barrier", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"VV", "[", "x", "]"}], ",", 
         RowBox[{"-", 
          RowBox[{"VV", "[", "x", "]"}]}], ",", 
         RowBox[{
          RowBox[{"VV", "[", "x", "]"}], "/", "\[Gamma]"}], ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"VV", "[", "x", "]"}]}], "/", "\[Gamma]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "8"}], ",", "26"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1.8"}], ",", "1.8"}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotLegends", "\[Rule]", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<\>\"", ",", "\"\<\>\"", ",", "\"\<\>\"", 
            ",", "\"\<\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"Left", ",", "Top"}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"LabelStyle", "->", "24"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ImageSize", "->", "Large"}]}], "\[IndentingNewLine]", "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"regionHeterogeneity", "=", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{"LightGray", ",", 
        RowBox[{"Rectangle", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"-", "2"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"L", ",", "2"}], "}"}]}], "]"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"barrierAux", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"VV", "[", "x", "]"}], ",", 
         RowBox[{"-", 
          RowBox[{"VV", "[", "x", "]"}]}], ",", 
         RowBox[{
          RowBox[{"VV", "[", "x", "]"}], "/", "\[Gamma]"}], ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"VV", "[", "x", "]"}]}], "/", "\[Gamma]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "8"}], ",", "26"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"img", "=", 
     RowBox[{"Show", "[", 
      RowBox[{"barrier", ",", "regionHeterogeneity", ",", "barrierAux"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "img", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"filename", ",", "img"}], "]"}], ";"}]}]}]], "Input",
