           RowBox[{
            RowBox[{"x", ">=", "0"}], "&&", 
            RowBox[{"x", "<", "x0"}]}]}], "}"}]}], "}"}], ",", "K"}], "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sigma", "[", "x_", "]"}], "=", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"x", "<", "0"}], ",", "sg1", ",", "True", ",", "sg3"}], 
