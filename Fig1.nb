         RowBox[{
          RowBox[{"VV", "[", "x", "]"}], "/", "\[Gamma]"}], ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"VV", "[", "x", "]"}]}], "/", "\[Gamma]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "20"}], ",", 
         RowBox[{"L", "+", "10"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
