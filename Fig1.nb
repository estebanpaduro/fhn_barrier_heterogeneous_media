       ",", "x0"}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"VV", "[", "x_", "]"}], "=", 
     RowBox[{"Piecewise", "[", 
