 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Case", " ", 
     RowBox[{"(", "ii", ")"}]}], ":", " ", 
    RowBox[{"Segment", " ", "with", " ", "depressed", " ", "dynamics"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"filename", "=", "\"\<Fig1b.pdf\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sg1", "=", "1"}], ";", 
    RowBox[{"sg2", "=", "1"}], ";", 
    RowBox[{"sg3", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "1"}], ":", " ", 
     RowBox[{"the", " ", "approach"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"valuek", "=", 
     RowBox[{"0.95", 
      RowBox[{"Min", "[", 
       RowBox[{"1", ",", "maxValuek"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vinf", "=", 
     RowBox[{"0.2", "valuek"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Value of vinf used: \>\"", ",", "vinf"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"V1", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"sg1", " ", 
           RowBox[{
            RowBox[{"v", "''"}], "[", "x", "]"}]}], "==", 
          RowBox[{"Piecewise", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"h", "[", 
                 RowBox[{"v", "[", "x", "]"}], "]"}], "-", 
                RowBox[{
                 RowBox[{"v", "[", "x", "]"}], "/", "\[Gamma]"}]}], ",", 
               RowBox[{
                RowBox[{"v", "[", "x", "]"}], ">", 
                RowBox[{"vinf", "+", 
                 RowBox[{"10", "^", 
                  RowBox[{"(", 
                   RowBox[{"-", "4"}], ")"}]}]}]}]}], "}"}], "}"}], ",", 
            "0"}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"v", "[", "0", "]"}], "==", "valuek"}], ",", " ", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"v", "'"}], "[", "0", "]"}], "==", 
          RowBox[{
           RowBox[{"Sqrt", "[", "2", "]"}], 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "/", "sg1"}], ")"}], 
             RowBox[{"Integrate", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"h", "[", "u", "]"}], "-", 
                RowBox[{"u", "/", "\[Gamma]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"u", ",", "vinf", ",", "valuek"}], "}"}]}], "]"}]}], 
            "]"}]}]}]}], "\[IndentingNewLine]", "}"}], ",", 
       "\[IndentingNewLine]", "v", ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "20"}], ",", "0"}], "}"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "2"}], ":", " ", 
     RowBox[{"The", " ", "climb"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "the", " ", "value", " ", "of", " ", "p", " ", "required",
      " ", "for", " ", "step", " ", "3"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pmin", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"v0", "-", "valuek"}], ")"}], "/", 
      RowBox[{
       RowBox[{"V1", "'"}], "[", "0", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Value v0 required for Step 3: \>\"", ",", "v0"}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Parameter p estimated with explicit formula: \>\"", ",", 
      "pmin"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p1", "=", 
     RowBox[{"pmin", "+", "0.001"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L", "=", "p1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Value of L calculated from p: \>\"", ",", "L"}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"V2", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"sg2", " ", 
           RowBox[{
            RowBox[{"v", "''"}], "[", "x", "]"}]}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{"v", "[", "0", "]"}], "==", 
          RowBox[{"V1", "[", "0", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"v", "'"}], "[", "0", "]"}], "==", 
          RowBox[{
           RowBox[{"V1", "'"}], "[", "0", "]"}]}]}], "}"}], ",", "v", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "L"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "3"}], ":", " ", 
     RowBox[{"The", " ", "Summit"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"V3", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"sg3", " ", 
           RowBox[{
            RowBox[{"v", "''"}], "[", "x", "]"}]}], "==", 
          RowBox[{
           RowBox[{"h", "[", 
            RowBox[{"v", "[", "x", "]"}], "]"}], "-", 
           RowBox[{
            RowBox[{"v", "[", "x", "]"}], "/", "\[Gamma]"}]}]}], ",", 
         RowBox[{
          RowBox[{"v", "[", "L", "]"}], "==", 
          RowBox[{"V2", "[", "L", "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"v", "'"}], "[", "L", "]"}], "==", 
          RowBox[{
           RowBox[{"V2", "'"}], "[", "L", "]"}]}]}], "}"}], ",", "v", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "L", ",", 
         RowBox[{"L", "+", "10"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqnx0", "=", 
     RowBox[{"FindRoot", "[", 
